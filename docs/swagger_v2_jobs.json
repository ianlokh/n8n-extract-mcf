            },
            {
              "description": "A hyperlink to this resource"
            },
            {
              "example": {
                "href": "https://mycareersfuture.sg/v2/companies/T08GB0046G/jobs"
              }
            }
          ]
        },
        "addresses": {
          "allOf": [
            {
              "$ref": "#/definitions/Link"
            },
            {
              "description": "A hyperlink to this resource"
            },
            {
              "example": {
                "href": "https://mycareersfuture.sg/v2/companies/T08GB0046G/addresses"
              }
            }
          ]
        },
        "schemes": {
          "allOf": [
            {
              "$ref": "#/definitions/Link"
            },
            {
              "description": "A hyperlink to this resource"
            },
            {
              "example": {
                "href": "https://mycareersfuture.sg/v2/companies/T08GB0046G/schemes"
              }
            }
          ]
        }
