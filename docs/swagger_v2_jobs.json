    "CompanyResponsive": {
      "type": "object",
      "properties": {
        "uen": {
          "type": "string",
          "description": "Company Uen",
          "example": "T08GB0064C"
        },
        "responsiveCreatedOn": {
          "type": "string",
          "description": "Created datetime of this record in company_responsive",
          "example": "2017-10-23T00:00:00.000Z"
        },
        "updatedAt": {
          "type": "string",
          "description": "Updated datetime of this record in company_responsive",
          "example": "2017-10-23T00:00:00.000Z"
        }
      }
    },
    "Company": {
      "x-nullable": true,
      "type": "object",
      "properties": {
        "uen": {
          "$ref": "#/definitions/CompanyUen"
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "description": "Description of the company that is lodged in their company profile, may include HTML elements",
          "example": "\u003Cp\u003E\r\n\tThe Government Technology Agency (GovTech) aims to transform the delivery of Government digital services by taking an &quot;outside-in&quot; view, putting citizens and businesses at the heart of everything we do. We also develop the Smart Nation infrastructure and applications, and facilitate collaboration with citizens and businesses to co-develop technologies.\u003C/p\u003E\r\n"
        },
        "logoFileName": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filename of the logo",
          "example": "08209124502e424116f3408cd1c5528c.jpg"
        },
        "logoUploadPath": {
          "type": [
            "string",
            "null"
          ],
          "description": "An internet accessible URI to retrieve the company's logo",
          "example": "https://s3-ap-southeast-1.amazonaws.com/ojmp-data/08209124502e424116f3408cd1c5528c.jpg"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Registered entity name",
          "example": "Government Technology Agency"
        },
        "ssicCode": {
          "type": [
            "string",
            "null"
          ],
          "description": "Singapore Standard Industrial Classification of the company obtained from MSF",
          "example": "28181"
        },
        "ssicCode2020": {
          "type": [
            "string",
            "null"
          ],
          "description": "Singapore Standard Industrial Classification of the company obtained from EDH",
          "example": "28181"
        },
        "badges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CompanyBadge"
          }
        },
        "addresses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CompanyAddress"
          }
        },
        "_links": {
          "$ref": "#/definitions/CompanySingleResourceLinks"
        },
        "responsiveEmployer": {
          "$ref": "#/definitions/CompanyResponsive"
        }
      },
      "required": [
        "uen",
        "description",
        "logoFileName",
        "logoUploadPath",
        "name",
        "ssicCode",
        "ssicCode2020",
        "_links"
      ]
    },
    "District": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique identifier of the district",
          "example": 13
        },
        "location": {
          "type": "string",
          "description": "Description of the district",
          "example": "D13 Macpherson, Braddell"
        },
        "region": {
          "type": "string",
          "description": "Description of the district region",
          "example": "Central"
        },
        "sectors": {
          "type": "array",
          "description": "Postal code sector of the district",
          "items": {
            "type": "string"
          },
          "example": [
            "34",
            "35",
            "36",
            "37"
          ]
        }
      },
      "required": [
        "id",
        "location",
        "region",
        "sectors"
      ]
    },
    "JobAddress": {
      "x-nullable": true,
      "type": "object",
      "properties": {
        "districts": {
          "items": {
            "$ref": "#/definitions/District"
          },
          "type": "array"
        },
        "overseasCountry": {
          "type": [
            "string",
            "null"
          ],
          "description": "Job overseas country",
          "example": "France"
        },
        "foreignAddress1": {
          "type": [
            "string",
            "null"
          ],
          "description": "Job overseas address 1",
          "example": "Lincoln street"
        },
        "foreignAddress2": {
          "type": [
            "string",
            "null"
          ],
          "description": "Job overseas address 2"
        },
        "block": {
          "type": [
            "string",
            "null"
