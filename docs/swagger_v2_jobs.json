{
  "swagger": "2.0",
  "info": {
    "version": "2.0.0",
    "title": "MyCareersFuture API"
  },
  "host": "api.mycareersfuture.gov.sg",
  "basePath": "/v2",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json; charset=utf-8"
  ],
  "definitions": {
    "PagedJobs": {
      "type": "object",
      "properties": {
        "results": {
          "items": {
            "$ref": "#/definitions/Job"
          }
        },
        "total": {
          "type": "integer",
          "example": 5
        },
        "countWithoutFilters": {
          "type": "integer",
          "example": 5
        },
        "_links": {
          "$ref": "#/definitions/PagedLinks"
        },
        "searchRankingId": {
          "type": "string",
          "example": "1cfc9d91-5402-45c5-a3f7-39c55b53ca74-1634534489.4013765"
        }
      },
      "required": [
        "countWithoutFilters",
        "results",
        "total"
      ]
    },
    "Job": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string",
          "description": "Unique identifier of the job title",
          "example": "4a97f1f46801650775e95d8e9688b61d"
        },
        "sourceCode": {
          "type": "string",
          "description": "Job source code",
          "example": "Employer Portal"
        },
        "title": {
          "type": "string",
          "description": "Job title"
        },
        "description": {
          "type": "string",
          "description": "Description of this job (html format)"
        },
        "minimumYearsExperience": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Minimum year of experience"
        },
        "otherRequirements": {
          "type": [
            "string",
            "null"
          ],
          "description": "Other requirement of this job (html format)"
        },
        "ssocCode": {
          "type": [
            "integer",
            "string"
          ],
          "description": "SSOC Code, Based on the feature flag USE_STRING_SSOC_CODE_IN_API allows string or integer type",
          "example": "3958"
        },
        "ssecEqa": {
          "type": [
            "string",
            "null"
          ],
          "description": "Education Qualification Code",
          "example": "92"
        },
        "ssecFos": {
          "type": [
            "string",
            "null"
          ],
          "description": "Education Field of Study Code",
          "example": "0521"
        },
        "workingHours": {
          "type": [
            "string",
            "null"
          ],
          "description": "Working hours"
        },
        "numberOfVacancies": {
          "type": "integer",
          "description": "A number of job vacancy",
          "example": 1
        },
        "psdUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "shiftPattern": {
          "$ref": "#/definitions/ShiftPattern"
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Category"
          }
        },
        "employmentTypes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EmploymentType"
          }
        },
        "flexibleWorkArrangements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlexibleWorkArrangement"
          }
        },
        "positionLevels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PositionLevel"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Skill"
          }
        },
        "schemes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JobScheme"
          }
        },
        "status": {
          "$ref": "#/definitions/JobStatus"
        },
        "postedCompany": {
          "$ref": "#/definitions/Company"
        },
        "hiringCompany": {
          "$ref": "#/definitions/Company"
        },
        "address": {
          "$ref": "#/definitions/JobAddress"
        },
        "metadata": {
          "$ref": "#/definitions/JobMetadata"
        },
        "salary": {
          "$ref": "#/definitions/JobSalary"
        },
        "jobTitles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JobTitle"
          }
        },
        "screeningQuestions": {
          "$ref": "#/definitions/JobScreeningQuestions"
        }
      },
      "required": [
        "uuid",
        "sourceCode",
        "title",
        "description",
        "ssocCode",
        "numberOfVacancies",
        "categories",
        "employmentTypes",
        "positionLevels",
        "status",
        "postedCompany",
        "skills",
        "metadata"
      ]
    },
    "PagedLinks": {
      "type": "object",
      "properties": {
        "self": {
          "allOf": [
            {
              "$ref": "#/definitions/Link"
            },
            {
              "description": "A hyperlink to this page of the collection"
            },
            {
              "example": {
                "href": "https://mycareersfuture.sg/v2/endpoint?name=sin&page=2"
              }
            }
          ]
        },
        "first": {
          "allOf": [
            {
              "$ref": "#/definitions/Link"
            },
            {
              "description": "A hyperlink to the first page in this collection"
            },
            {
              "example": {
                "href": "https://mycareersfuture.sg/v2/endpoint?name=sin"
              }
            }
          ]
        },
        "prev": {
          "allOf": [
            {
              "$ref": "#/definitions/Link"
            },
            {
              "description": "A hyperlink to the previous page in this collection"
            },
            {
              "example": {
                "href": "https://mycareersfuture.sg/v2/endpoint?name=sin&page=1"
              }
            }
          ]
        },
        "next": {
          "allOf": [
            {
              "$ref": "#/definitions/Link"
            },
            {
              "description": "A hyperlink to the next page in this collection"
            },
            {
              "example": {
                "href": "https://mycareersfuture.sg/v2/endpoint?name=sin&page=3"
              }
            }
          ]
        },
        "last": {
          "allOf": [
            {
              "$ref": "#/definitions/Link"
            },
            {
              "description": "A hyperlink to the last page in this collection"
            },
            {
              "example": {
                "href": "https://mycareersfuture.sg/v2/endpoint?name=sin&page=146"
              }
            }
          ]
        }
      },
      "required": [
        "self",
        "first",
        "last"
      ]
    },
    "ShiftPattern": {
      "x-nullable": true,
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/ShiftPatternId"
        },
        "shiftPattern": {
          "type": [
            "string",
            "null"
          ],
          "description": "Description of the shift pattern",
          "example": "CPSD"
        }
      },
      "required": [
        "id",
        "shiftPattern"
      ]
    },
    "Category": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/CategoryId"
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "description": "Description of the category",
          "example": "Customer Service"
        }
      },
      "required": [
        "id",
        "category"
      ]
    },
    "EmploymentType": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/EmploymentTypeId"
        },
        "employmentType": {
          "type": [
            "string",
            "null"
          ],
          "description": "Description of the employment type",
          "example": "Part-Time"
        }
      },
      "required": [
        "id",
        "employmentType"
      ]
    },
    "FlexibleWorkArrangementId": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Unique identifier of the Flexible Work Arrangement",
      "example": 6
    },
    "FlexibleWorkArrangement": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/FlexibleWorkArrangementId"
        },
        "flexibleWorkArrangement": {
          "type": "string",
          "description": "Description of Flexible Work Arrangement",
          "example": "Telecommuting"
        }
      },
      "required": [
        "id",
        "flexibleWorkArrangement"
      ]
    },
    "PositionLevelId": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Unique identifier of the position level",
      "example": 8
    },
    "PositionLevel": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/PositionLevelId"
        },
        "position": {
          "type": [
            "string",
            "null"
          ],
          "description": "Description of the position level",
          "example": "Senior Executive"
        }
      },
      "required": [
        "id",
        "position"
      ]
    },
    "SkillId": {
      "type": "integer",
      "description": "Unique identifier of the skill",
      "example": 10
    },
    "SkillUuid": {
      "type": "string",
      "description": "uuid of the skill",
      "example": "a7f5f35426b927411fc9231b56382173"
    },
    "SkillSingleResourceLinks": {
      "type": "object",
      "properties": {
        "self": {
          "allOf": [
            {
              "$ref": "#/definitions/Link"
            },
            {
              "description": "A hyperlink to this resource"
            },
            {
              "example": {
                "href": "https://mycareersfuture.sg/v2/skills/10"
              }
            }
          ]
        },
        "jobs": {
          "allOf": [
            {
              "$ref": "#/definitions/Link"
            },
            {
              "description": "A hyperlink to this resource"
            },
            {
              "example": {
                "href": "https://mycareersfuture.sg/v2/skills/5/jobs"
              }
            }
          ]
        }
      },
      "required": [
        "self",
        "jobs"
      ]
    },
    "SchemeSingleResourceLinks": {
      "type": "object",
      "properties": {
        "self": {
          "allOf": [
            {
              "$ref": "#/definitions/Link"
            },
            {
              "description": "A hyperlink to this resource"
            },
            {
              "example": {
                "href": "https://mycareersfuture.sg/v2/schemes/2"
              }
            }
          ]
        },
        "subSchemes": {
          "allOf": [
            {
              "$ref": "#/definitions/Link"
            },
            {
              "description": "A hyperlink to this resource"
            },
            {
              "example": {
                "href": "https://mycareersfuture.sg/v2/schemes/2/subSchemes"
              }
            }
          ]
        }
      },
      "required": [
        "self",
        "subSchemes"
      ]
    },
    "Skill": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/SkillId"
        },
        "uuid": {
          "$ref": "#/definitions/SkillUuid"
        },
        "skill": {
          "type": "string",
          "description": "Name of the skill",
          "example": "Python"
        },
        "_links": {
          "$ref": "#/definitions/SkillSingleResourceLinks"
        }
      },
      "required": [
        "uuid",
        "skill"
      ]
    },
    "SchemeId": {
      "type": [
        "integer"
      ],
      "description": "Unique identifier of the Scheme",
      "example": 2
    },
    "Scheme": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/SchemeId"
        },
        "scheme": {
          "type": [
            "string"
          ],
          "description": "Description of the Scheme",
          "example": "CSP"
        },
        "startDate": {
          "type": [
            "string",
            "null"
          ],
          "description": "The start date for validity of the scheme",
          "example": "2018-07-30"
        },
        "expiryDate": {
          "type": [
            "string",
            "null"
          ],
          "description": "The end date for validity of the scheme",
          "example": "2019-07-30"
        },
        "_links": {
          "$ref": "#/definitions/SchemeSingleResourceLinks"
        }
      },
      "required": [
        "id",
        "scheme"
      ]
    },
    "SubSchemeId": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Unique identifier of the SubScheme",
      "example": 188
    },
    "SubSchemeSingleResourceLinks": {
      "type": "object",
      "properties": {
        "self": {
          "allOf": [
            {
              "$ref": "#/definitions/Link"
            },
            {
              "description": "A hyperlink to this resource"
            },
            {
              "example": {
                "href": "https://mycareersfuture.sg/v2/schemes/2/subSchemes/60"
              }
            }
          ]
        }
      },
      "required": [
        "self"
      ]
    },
    "SubScheme": {
      "type": "object",
      "x-nullable": true,
      "properties": {
        "id": {
          "$ref": "#/definitions/SubSchemeId"
        },
        "schemeId": {
          "$ref": "#/definitions/SchemeId"
        },
        "programme": {
          "type": [
            "string"
          ],
          "description": "Description of the Sub Scheme",
          "example": "CCP for Travel Executives"
        },
        "startDate": {
          "type": [
            "string"
          ],
          "description": "The start date for validity of the scheme",
          "example": "2018-07-30"
        },
        "expiryDate": {
          "type": [
            "string"
          ],
          "description": "The end date for validity of the scheme",
          "example": "2019-07-30"
        },
        "_links": {
          "$ref": "#/definitions/SubSchemeSingleResourceLinks"
        }
      },
      "required": [
        "id",
        "schemeId",
        "programme"
      ]
    },
    "JobScheme": {
      "type": "object",
      "properties": {
        "scheme": {
          "$ref": "#/definitions/Scheme"
        },
        "subScheme": {
          "$ref": "#/definitions/SubScheme"
        }
      }
    },
    "JobStatusId": {
      "type": "integer",
      "description": "Unique identifier of the job status",
      "example": 102
    },
    "JobStatus": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/JobStatusId"
        },
        "jobStatus": {
          "type": "string",
          "description": "Description of the job status",
          "example": "Open"
        }
      },
      "required": [
        "id",
        "jobStatus"
      ]
    },
    "CompanyUen": {
      "type": "string",
      "description": "Unique Entity Number",
      "example": "199804247N"
    },
    "CompanyBadge": {
      "type": "object",
      "properties": {
        "badgeCode": {
          "type": "string",
          "description": "Badge code of Company Badge",
          "example": "001"
        },
        "badgeType": {
          "type": "string",
          "description": "Type of Company Badge",
          "example": "Tripartite"
        },
        "startDate": {
          "type": "string",
          "description": "Start date of this badge",
          "example": "2017-10-23T00:00:00.000Z"
        },
        "expiryDate": {
          "type": "string",
          "description": "Expiry date of this badge",
          "example": "2017-10-23T00:00:00.000Z"
        },
        "badgeName": {
          "type": "string",
          "description": "Name of this badge",
          "example": "Tripartite Standard on Employment of Term Contract Employees"
        },
        "description": {
          "type": "string",
          "description": "Description of this badge",
          "example": "Managing term contract staff fairly, and providing appropriate benefits."
        },
        "url": {
          "type": "string",
          "description": "URL of this badge",
          "example": "https://www.tafep.sg/employment-term-contract-employees"
        }
      },
      "required": [
        "badgeCode",
        "badgeType",
        "badgeName",
        "startDate",
        "expiryDate"
      ]
    },
    "CompanyAddress": {
      "type": "object",
      "properties": {
        "postalCode": {
          "type": "string",
          "example": "140112"
        },
        "block": {
          "type": "string",
          "example": "9"
        },
        "street": {
          "type": "string",
          "example": "Some Street"
        },
        "building": {
          "type": [
            "string",
            "null"
          ],
          "example": "Some Building"
        },
        "floor": {
          "type": [
            "string"
          ],
          "example": "2"
        },
        "unit": {
          "type": [
            "string"
          ],
          "example": "9"
        },
        "purpose": {
          "type": "string",
          "description": "Type of address. Possible values:\n  - `registered`: official registered address of Entity\n  - `operating`: operating address of Entity; i.e. where the entity operates their business.\n  - `correspondence`: correspondence address of Entity\n",
          "enum": [
            "registered",
            "operating",
            "correspondence"
          ],
          "example": "operating"
        }
      },
      "required": [
        "postalCode",
        "block",
        "street",
        "purpose"
      ]
    },
